# MongoDB connection. Atlas free tier works: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tilawah
MONGODB_URI=mongodb://127.0.0.1:27017/tilawah

# Required to issue login tokens. Render can generate this.
JWT_SECRET=replace-with-a-long-random-string

# Transcription. auto prefers Hugging Face, then the self-hosted service, then OpenAI.
# TRANSCRIPTION_PROVIDER=auto | huggingface | selfhost | openai
TRANSCRIPTION_PROVIDER=auto

# Free tier: Hugging Face Inference API for tarteel-ai/whisper-base-ar-quran.
# Create a token at https://huggingface.co/settings/tokens (read is enough).
HF_TOKEN=
HF_MODEL=tarteel-ai/whisper-base-ar-quran
# Optional override. Defaults try the HF router, then the classic inference host.
HF_INFERENCE_URL=

# Self-hosted ASR. Any service that accepts multipart field "file" and returns { "text": "..." }.
# The Python service in server/asr is one implementation and does not need HF_TOKEN after the model is downloaded.
SELFHOST_ASR_URL=http://127.0.0.1:8080/transcribe

# Optional. Used only when TRANSCRIPTION_PROVIDER=openai, or as the last auto fallback.
OPENAI_API_KEY=

# Google ID token audience. Required for Google sign-in. Email/password works without it.
GOOGLE_CLIENT_ID=

# RevenueCat webhook. Send Authorization: Bearer <secret>. Empty disables the check only when unset in development.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=premium

PORT=8787
